# Copia este archivo como .env y completa los valores SOLO en tu computadora.
# No subas .env a GitHub ni compartas credenciales.
DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@127.0.0.1:3306/tutorloreto

# Servicio de inteligencia artificial local (Ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Tutor opcional en línea (proveedor compatible con OpenAI Chat Completions).
# La clave se guarda SOLO en .env del servidor; nunca en JavaScript ni en GitHub.
# Deja TUTOR_ONLINE_API_KEY vacío para desactivar esta modalidad.
TUTOR_ONLINE_API_KEY=
TUTOR_ONLINE_BASE_URL=https://api.openai.com/v1
TUTOR_ONLINE_MODEL=gpt-4o-mini
